<UserControl x:Class="UserControlsWPF.NumericUpDown.NumericUpDown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UserControlsWPF.NumericUpDown"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             x:Name="Root">
    <UserControl.Resources>
        <local:DecimalConverter x:Key="DecimalConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <TextBox
            Grid.Column="0">
            <TextBox.Text>
                <MultiBinding Converter="{StaticResource DecimalConverter}" UpdateSourceTrigger="PropertyChanged">
                    <Binding Path="Value"/>
                    <Binding Path="StringFormat"/>
                </MultiBinding>
            </TextBox.Text>
        </TextBox>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <RepeatButton
                Grid.Row="0"
                Command="{Binding ElementName=Root, Path=UpCommand}"/>
            <RepeatButton
                Grid.Row="1"
                Command="{Binding ElementName=Root, Path=DownCommand}"/>
        </Grid>
    </Grid>
</UserControl>
